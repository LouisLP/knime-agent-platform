# Copy to .env and fill in. Never commit .env.
# Blank means "unset": the value shown is the default, and vars the chosen MCP
# transport does not use can be left empty. Validated at boot by src/config/env.ts.

PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Max model<->tool round trips per user message before we give up.
MAX_TOOL_ITERATIONS=5

# --- MCP server ---
# transport: "http" (streamable HTTP) or "stdio"
MCP_TRANSPORT=http

# Required for MCP_TRANSPORT=http
MCP_SERVER_URL=

# Required for MCP_TRANSPORT=stdio; MCP_ARGS is space-separated argv.
MCP_COMMAND=
MCP_ARGS=
