# Copy to .env and fill in. Never commit .env.
# Blank means "unset": the value shown is the default, and vars the chosen MCP
# transport does not use can be left empty. Validated at boot by src/config/env.ts.

PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Max model<->tool round trips per user message before we give up.
MAX_TOOL_ITERATIONS=5

# --- MCP server ---
# The filesystem server, launched as a child process over stdio. Version is
# pinned because the package uses CalVer and its tool set changes per release.
MCP_TRANSPORT=stdio
MCP_COMMAND=npx
MCP_ARGS=["-y","@modelcontextprotocol/server-filesystem@2026.7.10"]

# The server's allowed root, appended to MCP_ARGS. Blank uses the committed
# <repo>/sandbox. A relative path resolves against the backend's working dir.
MCP_SANDBOX_DIR=

# Windows: npx is a .cmd shim and the child is spawned with shell:false, so use
# MCP_COMMAND=cmd and MCP_ARGS=["/c","npx","-y","@modelcontextprotocol/server-filesystem@2026.7.10"]

# The streamable-HTTP transport also works (MCP_TRANSPORT=http), and then only
# MCP_SERVER_URL is read. Nothing in the demo setup uses it.
MCP_SERVER_URL=
